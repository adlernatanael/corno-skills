---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Command from "../components/Command.astro";
import { groupedSkills, loadSkills } from "../lib/skills";
import { INSTALL_CLAUDE } from "../lib/links";
import { BEFORE_AFTER, SCENES } from "../lib/examples";

const skills = loadSkills();
const groups = groupedSkills();
const triggers = skills.flatMap((s) => s.triggers.slice(0, 2));

// Rolling pasture drawn in code: each hill line is a sum of sines with seeded phases, so the scene is stable between
// builds and needs no image.
function rand(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function hill(seed: number, base: number, amp: number) {
  const r = rand(seed);
  const waves = [0, 1, 2].map((k) => ({ f: (k + 1) * (0.004 + r() * 0.004), p: r() * 6.28, a: amp / (k + 1) }));
  let d = `M0 600 L0 ${base}`;
  for (let x = 0; x <= 1600; x += 16) {
    const y = base + waves.reduce((sum, w) => sum + Math.sin(x * w.f + w.p) * w.a, 0);
    d += ` L${x} ${y.toFixed(1)}`;
  }
  return d + " L1600 600 Z";
}
const hills = [
  { d: hill(7, 330, 26), fill: "#2a2a2a", depth: 6 },
  { d: hill(19, 395, 22), fill: "#1c1c1c", depth: 12 },
  { d: hill(31, 460, 18), fill: "#111111", depth: 20 },
];
const posts = Array.from({ length: 17 }, (_, i) => 40 + i * 96);
const steps = ["Instala", "Pede do seu jeito", "Recebe com prova"];
const pairs = BEFORE_AFTER.slice(0, 6);
---
<Base title="Corno: deixe de ser corno junto com seu agente" description="Skills que fazem seu agente terminar de verdade, procurar a causa do bug e parar de elogiar sua ideia ruim." gate>
  <Header tone="dark" />
  <div class="page-body v3">
    <main tabindex="-1">
      <section class="hero-wrap" data-hero>
        <div class="frame">
          <svg class="scene" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <rect width="1600" height="600" fill="#3a3a3a" />
            <circle class="moon" cx="1020" cy="150" r="58" fill="#f5f5f5" />
            {hills.map((h) => <path class="layer" d={h.d} fill={h.fill} style={`--depth: ${h.depth}`} />)}
            <g class="fence layer" style="--depth: 26">
              <rect x="0" y="508" width="1600" height="6" fill="#050505" />
              <rect x="0" y="540" width="1600" height="6" fill="#050505" />
              {posts.map((x) => <rect x={x} y="486" width="10" height="114" fill="#050505" />)}
            </g>
          </svg>
          <div class="hero-copy">
            <h1>
              {"Deixe de ser corno junto com seu agente.".split(" ").map((w, i) => (
                <span class="word">
                  <span style={`--i: ${i}`}>{w}</span>
                </span>
              ))}
            </h1>
            <div class="hero-cta">
              <Command code={INSTALL_CLAUDE[0]} />
            </div>
          </div>
        </div>
      </section>

      <section class="marquee" aria-label="Frases que chamam as skills">
        {
          [0, 1].map((row) => (
            <div class="track" data-row={row} aria-hidden={row === 1 ? "true" : undefined}>
              {[...triggers, ...triggers].map((t, i) => (
                <span class="phrase" aria-hidden={i >= triggers.length ? "true" : undefined}>
                  “{t}”
                </span>
              ))}
            </div>
          ))
        }
      </section>

      <section class="sec container" aria-labelledby="how-title">
        <h2 id="how-title">Como funciona</h2>
        <div class="how" data-steps>
          <ol class="steps">
            {
              steps.map((s, i) => (
                <li>
                  <button type="button" class="step" data-step={i} aria-pressed={i === 0 ? "true" : "false"}>
                    <span class="step-n">{i + 1}</span>
                    {s}
                  </button>
                </li>
              ))
            }
          </ol>
          <div class="panel" aria-live="polite">
            <div data-card="0">
              <Command code={INSTALL_CLAUDE[0]} />
              <Command code={INSTALL_CLAUDE[1]} />
            </div>
            <div data-card="1" hidden>
              <p class="bubble">meu disco tá cheio, o que posso apagar?</p>
            </div>
            <div data-card="2" hidden>
              <p class="mono">Livre antes: 12 GB. Agora: 53 GB.</p>
              <p class="mono dim">Pulei 2 pastas com código sem commit.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="sec container" aria-labelledby="tabs-title">
        <h2 id="tabs-title">O curral</h2>
        <div class="tablist" role="tablist" aria-label="Assuntos">
          {
            groups.map((g, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                {g.title}
              </button>
            ))
          }
          <span class="tab-ind" aria-hidden="true" />
        </div>
        {
          groups.map((g, i) => (
            <div class="tabpanel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
              <ul class="names">
                {g.skills.map((s) => (
                  <li>
                    <a href={`/skills/${s.name}/`}>{s.name}</a>
                  </li>
                ))}
              </ul>
              {SCENES[g.title] && (
                <div class="term">
                  <p class="you">{SCENES[g.title].you}</p>
                  <p>{SCENES[g.title].agent}</p>
                </div>
              )}
            </div>
          ))
        }
      </section>

      <section class="sec container" aria-labelledby="wall-title">
        <h2 id="wall-title">Antes e depois</h2>
        <ul class="pairs">
          {
            pairs.map((b) => (
              <li class="pair">
                <p class="before">{b.before}</p>
                <p class="after">{b.after}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sec container final">
        <h2>Bota o boi no curral.</h2>
        <div class="final-cmds">{INSTALL_CLAUDE.map((c) => <Command code={c} />)}</div>
      </section>
    </main>
  </div>
  <Footer />
</Base>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Hero: the frame closes into a rounded card as the page scrolls, and the hills drift with the pointer.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero && !still) {
    const onScroll = () => hero.style.setProperty("--p", String(Math.min(1, Math.max(0, scrollY / (innerHeight * 0.7)))));
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    hero.addEventListener("pointermove", (e) => hero.style.setProperty("--mx", String(e.clientX / innerWidth - 0.5)));
  }

  // Steps advance on their own every 4 s, pause on hover, focus or off screen, and answer clicks.
  const stepsRoot = document.querySelector<HTMLElement>("[data-steps]");
  if (stepsRoot) {
    const buttons = [...stepsRoot.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const cards = [...stepsRoot.querySelectorAll<HTMLElement>("[data-card]")];
    let current = 0;
    let paused = false;
    let onScreen = true;
    const show = (i: number) => {
      current = i;
      buttons.forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
      cards.forEach((c, k) => (c.hidden = k !== i));
    };
    buttons.forEach((b, i) => b.addEventListener("click", () => show(i)));
    for (const [on, off] of [["pointerenter", "pointerleave"], ["focusin", "focusout"]]) {
      stepsRoot.addEventListener(on, () => (paused = true));
      stepsRoot.addEventListener(off, () => (paused = false));
    }
    new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(stepsRoot);
    if (!still) setInterval(() => !paused && onScreen && show((current + 1) % buttons.length), 4000);
  }

  // Tabs: click or arrow keys, with an indicator that slides under the active tab.
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const ind = tablist.querySelector<HTMLElement>(".tab-ind");
    const active = () => Math.max(0, tabs.findIndex((t) => t.getAttribute("aria-selected") === "true"));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === i));
        t.tabIndex = k === i ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = k !== i;
      });
      if (focus) tabs[i].focus();
      ind?.style.setProperty("--x", `${tabs[i].offsetLeft}px`);
      ind?.style.setProperty("--w", `${tabs[i].offsetWidth}px`);
    };
    tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));
    tablist.addEventListener("keydown", (e) => {
      const next = { ArrowRight: active() + 1, ArrowLeft: active() - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select((next + tabs.length) % tabs.length, true);
    });
    addEventListener("resize", () => select(active()));
    select(0);
  }
</script>

<style is:global>
  /* The dark page shows through the footer's rounded corners, so the document behind it is dark too. */
  html:has(.v3) {
    background: #0a0a0a;
  }
</style>

<style>
  .v3 {
    --line-d: rgb(255 255 255 / 0.12);
    --surface-d: #161616;
    --fg: #fafafa;
    --fg-2: rgb(250 250 250 / 0.6);
    padding-top: 0;
    background: #0a0a0a;
    color: var(--fg);
  }

  /* One rhythm for every section: same top space, same heading, same width. */
  .sec {
    padding-block: 96px 0;
  }
  .sec h2 {
    margin-bottom: 32px;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  /* Hero */
  .hero-wrap {
    --p: 0;
    --mx: 0;
    padding: 0 calc(var(--p) * 16px);
  }
  .frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(780px, 100dvh);
    overflow: hidden;
    clip-path: inset(0 round calc(var(--p) * 28px));
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .layer {
    transform: translate(calc(var(--mx) * var(--depth) * -1px), calc(var(--p) * var(--depth) * 2px));
    transition: transform 400ms var(--ease-out);
  }
  .moon {
    transform: translateY(calc(var(--p) * 60px));
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(1120px, 100% - 32px);
    margin: 0 auto;
    padding: 140px 0 clamp(56px, 10vh, 104px);
    transform: translateY(calc(var(--p) * -40px));
  }
  h1 {
    max-width: 13ch;
    font-size: clamp(44px, 7vw, 96px);
    font-weight: 750;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  .word {
    display: inline-block;
    overflow: hidden;
    margin-right: 0.22em;
    padding-bottom: 0.06em;
    vertical-align: top;
  }
  .word > span {
    display: inline-block;
  }
  .hero-cta {
    max-width: 520px;
    margin-top: 32px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .word > span {
      animation: rise 800ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 70ms);
    }
    .hero-cta {
      animation: fade 700ms 650ms var(--ease-out) both;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* Marquee */
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 56px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 12px;
    width: max-content;
  }
  .phrase {
    padding: 10px 16px;
    border: 1px solid var(--line-d);
    border-radius: 999px;
    color: var(--fg-2);
    font-size: 15px;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: slide 60s linear infinite;
    }
    .track[data-row="1"] {
      animation-direction: reverse;
      animation-duration: 75s;
    }
    .marquee:hover .track {
      animation-play-state: paused;
    }
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* How it works */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 60px;
    padding: 0 16px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: var(--fg-2);
    font: inherit;
    font-size: 18px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }
  .step[aria-pressed="true"] {
    background: var(--surface-d);
    color: var(--fg);
  }
  .step-n {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line-d);
    border-radius: 50%;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .step[aria-pressed="true"] .step-n {
    border-color: var(--fg);
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: 220px;
    padding: 28px;
    border: 1px solid var(--line-d);
    border-radius: 20px;
    background: var(--surface-d);
  }
  .panel > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .panel > div[hidden] {
    display: none;
  }
  .bubble {
    align-self: flex-start;
    padding: 14px 18px;
    border-radius: 18px 18px 18px 6px;
    background: var(--fg);
    color: #0a0a0a;
    font-size: 18px;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 16px;
  }
  .dim {
    color: var(--fg-2);
  }

  /* Tabs */
  .tablist {
    position: relative;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line-d);
    scrollbar-width: none;
  }
  [role="tab"] {
    flex: none;
    min-height: 48px;
    padding: 0 16px;
    border: 0;
    background: none;
    color: var(--fg-2);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  [role="tab"][aria-selected="true"] {
    color: var(--fg);
  }
  [role="tab"]:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: -4px;
    border-radius: 8px;
  }
  .tab-ind {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: var(--w, 0);
    height: 2px;
    background: var(--fg);
    transform: translateX(var(--x, 0));
    transition:
      transform 250ms var(--ease-out),
      width 250ms var(--ease-out);
  }
  .tabpanel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    padding-top: 24px;
  }
  .tabpanel[hidden] {
    display: none;
  }
  .names {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .names a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 12px;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 17px;
    text-decoration: none;
  }
  @media (hover: hover) {
    .names a:hover {
      background: var(--surface-d);
    }
  }
  .term {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--line-d);
    border-radius: 20px;
    background: var(--surface-d);
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .you {
    color: var(--fg-2);
  }
  .you::before {
    content: "> ";
  }

  /* Before and after */
  .pairs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pair {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--line-d);
    border-radius: 20px;
  }
  .before {
    color: rgb(250 250 250 / 0.4);
    text-decoration: line-through;
  }
  .after {
    font-size: 17px;
  }

  /* Final */
  .final {
    padding-bottom: 140px;
  }
  .final-cmds {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
  }

  @media (max-width: 860px) {
    .how,
    .tabpanel,
    .pairs {
      grid-template-columns: minmax(0, 1fr);
    }
    .frame {
      min-height: 640px;
    }
    .sec {
      padding-top: 72px;
    }
  }
</style>
