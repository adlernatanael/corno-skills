---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import MarkdownIt from "markdown-it";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Command from "../../components/Command.astro";
import Footer from "../../components/Footer.astro";
import SkillRun from "../../components/SkillRun.astro";
import { loadSkills, SKILLS_DIR, type Skill } from "../../lib/skills";
import { INSTALL_CLAUDE } from "../../lib/links";

export function getStaticPaths() {
  return loadSkills().map((skill) => ({ params: { name: skill.name }, props: { skill } }));
}

const { skill } = Astro.props as { skill: Skill };
const md = new MarkdownIt({ html: false, linkify: true });
const extras = skill.files
  .filter((f) => f !== "SKILL.md")
  .map((f) => {
    const text = readFileSync(join(SKILLS_DIR, skill.name, f), "utf8");
    return { path: f, html: f.endsWith(".md") ? md.render(text) : null, text };
  });
---
<Base title={`${skill.name} · Corno`} description={skill.description}>
  <Header />
  <div class="page-body">
    <main class="container" tabindex="-1">
      <a class="back" href="/#curral">Voltar ao curral</a>

      <header class="head">
        <h1>{skill.short}</h1>
        <p class="name">{skill.name}</p>
        <p class="lead">{skill.summary}.</p>
      </header>

      <div class="layout">
        <div class="main">
          <section aria-labelledby="pratica">
            <h2 id="pratica">Na prática</h2>
            <SkillRun name={skill.name} />
          </section>

          <section aria-labelledby="como">
            <h2 id="como">Como ela trabalha</h2>
            <article class="prose" set:html={md.render(skill.body)} />
          </section>

          {
            extras.length > 0 && (
              <section aria-labelledby="arquivos">
                <h2 id="arquivos">Arquivos de apoio</h2>
                {extras.map((e) => (
                  <details>
                    <summary>
                      <code>{e.path}</code>
                    </summary>
                    {e.html ? <div class="prose" set:html={e.html} /> : <pre><code>{e.text}</code></pre>}
                  </details>
                ))}
              </section>
            )
          }
        </div>

        <aside class="side" aria-label="Instalar e usar">
          <div class="box">
            <h2>Instalar</h2>
            <a class="button button-primary" href={`/downloads/${skill.name}.zip`} download>Baixar .zip</a>
            <p class="hint">No Claude Code, com todas as outras:</p>
            <Command code={INSTALL_CLAUDE[1]} />
            <p class="hint">Com o repositório clonado:</p>
            <Command code={`cp -R ~/corno-skills/skills/${skill.name} ~/.claude/skills/`} />
          </div>

          <div class="box">
            <h2>{skill.manualOnly ? "Como chamar" : "O agente usa quando você diz"}</h2>
            {
              skill.manualOnly ? (
                <p class="hint">
                  Só quando chamada pelo nome: <code>/{skill.name}</code>
                </p>
              ) : skill.triggers.length ? (
                <ul class="says">
                  {skill.triggers.map((t) => (
                    <li>“{t}”</li>
                  ))}
                </ul>
              ) : (
                <p class="hint">{skill.when}</p>
              )
            }
          </div>

          {
            skill.files.length > 1 && (
              <div class="box">
                <h2>Arquivos</h2>
                <ul class="files">
                  {skill.files.map((f) => (
                    <li>
                      <code>{f}</code>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </main>
  </div>
  <Footer />
</Base>

<style>
  main {
    padding-block: 24px 112px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    font-size: 15px;
    text-decoration: none;
  }
  .head {
    max-width: 760px;
    padding-bottom: 40px;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 750;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .name {
    margin-top: 10px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .lead {
    margin-top: 18px;
    font-size: 20px;
    line-height: 1.45;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
    align-items: start;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 56px;
    min-width: 0;
  }
  .main h2,
  .box h2 {
    margin-bottom: 16px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .side {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 20px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .box h2 {
    margin-bottom: 4px;
  }
  .hint {
    margin-top: 6px;
    color: var(--ink-3);
    font-size: 14px;
  }
  .says,
  .files {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .files {
    color: var(--ink-2);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  .prose {
    font-size: 16px;
    line-height: 1.65;
    overflow-wrap: break-word;
  }
  .prose :global(h1) {
    font-size: 26px;
  }
  .prose :global(h2) {
    margin-top: 40px;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin-top: 28px;
    font-size: 18px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(table) {
    margin-top: 14px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(code) {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--canvas);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    overflow-x: auto;
    max-width: 100%;
    padding: 14px 16px;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: #f5f5f5;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    overflow-wrap: normal;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(a) {
    color: var(--ink);
  }

  details {
    margin-top: 10px;
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    cursor: pointer;
  }
  details > :global(.prose),
  details > pre {
    margin: 0;
    padding: 0 16px 16px;
  }
  details > pre {
    overflow-x: auto;
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .side {
      position: static;
      order: -1;
    }
  }
</style>
