---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import AsciiBoi from "../components/AsciiBoi.astro";
import Command from "../components/Command.astro";
import Footer from "../components/Footer.astro";
import { groupedSkills } from "../lib/skills";
import { INSTALL_CLAUDE, INSTALL_CLONE } from "../lib/links";

const groups = groupedSkills();
const title = "Corno: skills para o seu agente";
const description =
  "Skills para Claude Code e outros agentes: confere antes de dizer pronto, investiga bug com método, tira a cara de IA da sua tela e julga sua ideia e seu currículo sem passar pano.";
---
<Base title={title} description={description} gate>
  <Header />
  <div class="page-body">
  <main tabindex="-1">
    <section class="hero container">
      <div class="hero-text">
        <h1>Skills pra deixar seu agente menos corno.</h1>
        <p class="lead muted">Ele confere antes de dizer pronto, investiga antes de chutar e larga a cara de IA.</p>
        <div class="hero-install">
          <Command code={INSTALL_CLAUDE[0]} />
          <p class="muted small">No Claude Code. Outro agente? <a href="#instalar">Veja como instalar</a>.</p>
        </div>
      </div>
      <div class="hero-art"><AsciiBoi /></div>
    </section>

    <section class="curral container" id="curral" aria-labelledby="curral-title">
      <h2 id="curral-title">Curral das skills</h2>
      {
        groups.map((g) => (
          <div class="group">
            <h3 class="group-title">{g.title}</h3>
            <ul class="cards">
              {g.skills.map((s) => (
                <li class="card">
                  <div class="card-head">
                    <h4>
                      <a href={`/skills/${s.name}/`}>{s.short}</a>
                    </h4>
                    <a class="zip" href={`/downloads/${s.name}.zip`} download aria-label={`Baixar ${s.name} em .zip`}>
                      .zip
                    </a>
                  </div>
                  <p class="muted">{s.summary}.</p>
                  {s.triggers[0] && <p class="say">Diga “{s.triggers[0]}”</p>}
                  {s.manualOnly && <p class="manual">Só roda quando chamada pelo nome</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="install container" id="instalar" aria-labelledby="instalar-title">
      <h2 id="instalar-title">Bota no curral</h2>
      <div class="install-grid">
        <div class="install-block">
          <h3>Claude Code</h3>
          <p class="muted">Dentro de uma sessão, adicione o curral e instale tudo de uma vez:</p>
          {INSTALL_CLAUDE.map((c) => <Command code={c} />)}
        </div>
        <div class="install-block">
          <h3>Qualquer agente</h3>
          <p class="muted">Clone e copie as pastas para onde o seu agente lê skills (o exemplo usa a do Claude Code):</p>
          {INSTALL_CLONE.map((c) => <Command code={c} />)}
          <p class="muted small">
            Ou baixe o <a href="/downloads/corno-skills.zip" download>.zip com todas</a> e descompacte na pasta de skills.
          </p>
        </div>
      </div>
    </section>
  </main>
  </div>
  <Footer />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding-block: 56px 72px;
  }
  h1 {
    max-width: 14ch;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .lead {
    max-width: 36ch;
    margin-top: 20px;
    font-size: 19px;
  }
  .hero-install {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
    margin-top: 32px;
  }
  .hero-art {
    max-width: 520px;
    justify-self: end;
    width: 100%;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .curral {
    padding-block: 24px 64px;
  }
  .group {
    margin-top: 36px;
  }
  .group-title {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: box-shadow 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover {
      box-shadow: var(--shadow-card-hover);
    }
  }
  /* The card is the target, so the focus ring goes around the card. */
  .card:has(h4 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .card h4 a:focus-visible {
    outline: none;
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .card h4 {
    margin: 0;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  /* The whole card opens the skill; the .zip link sits above that layer. */
  .card h4 a {
    text-decoration: none;
  }
  .card h4 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card p {
    display: -webkit-box;
    overflow: hidden;
    font-size: 15px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .card .say {
    margin-top: auto;
    padding-top: 4px;
    color: var(--accent-ink);
    font-size: 13px;
    font-weight: 500;
  }
  .card .manual {
    color: var(--wood);
    font-size: 13px;
    font-weight: 500;
  }
  .zip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -10px -10px -10px 0;
    padding: 0 10px;
    border-radius: 6px;
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) {
    .zip:hover {
      background: var(--accent-tint);
    }
  }

  .install {
    padding-block: 24px 80px;
  }
  .install-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .install-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--canvas);
  }
  .install-block h3 {
    font-size: 20px;
    font-weight: 650;
  }
  .small {
    font-size: 14px;
  }


  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 24px 48px;
    }
    .hero-art {
      justify-self: center;
      max-width: 360px;
      order: -1;
    }
    .install-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
