---
import { REPO, REPO_URL } from "../lib/links";
interface Props {
  /** Dark pages get a dark glass bar. */
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
---
<header class="header" data-tone={tone}>
  <div class="bar container">
    <a class="brand" href="/">
      <img src="/boi.svg" alt="" width="28" height="22" />
      corno
    </a>
    <nav aria-label="Principal">
      <a href="/#curral">Curral</a>
      <a href="/#instalar">Instalar</a>
      <a class="stars" href={REPO_URL} data-repo={REPO}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>Estrela<span class="visually-hidden"> no Corno no GitHub</span></span>
        <span class="count" data-stars hidden></span>
      </a>
    </nav>
  </div>
</header>

<script>
  // The count comes straight from GitHub's public API (no server needed). Rate limit, a private repo or no network
  // leave the pill as a plain link.
  const pill = document.querySelector<HTMLElement>("[data-repo]");
  const count = pill?.querySelector<HTMLElement>("[data-stars]");
  if (pill && count) {
    fetch(`https://api.github.com/repos/${pill.dataset.repo}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!Number.isInteger(data?.stargazers_count)) return;
        count.textContent = new Intl.NumberFormat("pt-BR", { notation: "compact", maximumFractionDigits: 1 }).format(data.stargazers_count);
        count.hidden = false;
      })
      .catch(() => {});
  }

  // The bar firms up once the page leaves the top.
  const header = document.querySelector<HTMLElement>(".header");
  const update = () => header?.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<style>
  /* Floating glass bar: the page shows through, blurred and a touch more saturated, with a bright top edge
     like light catching the rim. */
  .header {
    position: fixed;
    inset: max(10px, env(safe-area-inset-top)) 0 auto;
    z-index: 40;
    pointer-events: none;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 0 8px 0 16px;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 18px;
    background: rgb(250 250 250 / 0.68);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.75),
      inset 0 -1px 0 rgb(10 10 10 / 0.04),
      0 1px 2px rgb(10 10 10 / 0.06),
      0 8px 24px rgb(10 10 10 / 0.06);
    backdrop-filter: blur(18px) saturate(1.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.8);
    pointer-events: auto;
    transition: background-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  .header[data-scrolled] .bar {
    background: rgb(250 250 250 / 0.8);
  }
  /* Browsers without backdrop-filter get a solid bar instead of unreadable text over the page. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bar,
    .header[data-scrolled] .bar {
      background: var(--page);
    }
  }
  .header[data-tone="dark"] .bar {
    border-color: rgb(255 255 255 / 0.12);
    background: rgb(18 18 18 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 8px 24px rgb(0 0 0 / 0.3);
    color: #fafafa;
  }
  .header[data-tone="dark"][data-scrolled] .bar {
    background: rgb(18 18 18 / 0.72);
  }
  .header[data-tone="dark"] .brand img {
    filter: invert(1);
  }
  .header[data-tone="dark"] nav a:not(.stars) {
    color: rgb(255 255 255 / 0.7);
  }
  .header[data-tone="dark"] .stars {
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .header[data-tone="dark"] .count {
    border-color: rgb(255 255 255 / 0.18);
    color: rgb(255 255 255 / 0.7);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  nav a:not(.stars) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: 6px;
    padding: 0 12px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.7);
    box-shadow: var(--shadow-btn);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 120ms var(--ease-out);
  }
  .count {
    padding-left: 8px;
    border-left: 1px solid var(--line);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) {
    nav a:not(.stars):hover {
      background: rgb(10 10 10 / 0.06);
      color: var(--ink);
    }
    .stars:hover {
      background: #fff;
    }
    .header[data-tone="dark"] nav a:not(.stars):hover {
      background: rgb(255 255 255 / 0.08);
      color: #fff;
    }
    .header[data-tone="dark"] .stars:hover {
      background: rgb(255 255 255 / 0.16);
    }
  }
  @media (max-width: 420px) {
    nav a:not(.stars) {
      display: none;
    }
  }
</style>
