---
// The bull from /boi.svg extruded into 3D with Three.js: each shape becomes a solid with its own depth, and the head
// turns toward the pointer. Without WebGL (or with reduced motion) the flat SVG shows instead.
---
<div class="boi3d">
  <img class="fallback" src="/boi.svg" alt="Cabeça de boi com chifres" width="400" height="320" />
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .boi3d {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
  }
  .boi3d canvas,
  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fallback {
    object-fit: contain;
    padding: 12%;
  }
  .boi3d[data-ready] .fallback {
    visibility: hidden;
  }
</style>

<script>
  import * as THREE from "three";
  import { SVGLoader } from "three/examples/jsm/loaders/SVGLoader.js";

  const root = document.querySelector<HTMLElement>(".boi3d");
  const canvas = root?.querySelector("canvas");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && canvas && !still) {
    let renderer: THREE.WebGLRenderer | undefined;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      renderer = undefined;
    }
    if (renderer) start(renderer, root, canvas);
  }

  async function start(renderer: THREE.WebGLRenderer, root: HTMLElement, canvas: HTMLCanvasElement) {
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 1, 2000);
    camera.position.set(0, 0, 520);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x3a3f35, 1.6));
    const key = new THREE.DirectionalLight(0xffffff, 2.4);
    key.position.set(-180, 260, 400);
    scene.add(key);

    const data = new SVGLoader().parse(await (await fetch("/boi.svg")).text());
    const bull = new THREE.Group();
    // Later shapes sit a little in front, so eyes and nostrils stay on top of the head they belong to.
    data.paths.forEach((path, i) => {
      const color = path.color ?? new THREE.Color(0x1c1916);
      const material = new THREE.MeshStandardMaterial({ color, roughness: 0.55, metalness: 0.05 });
      for (const shape of SVGLoader.createShapes(path)) {
        const depth = i < 2 ? 14 : 22;
        const geometry = new THREE.ExtrudeGeometry(shape, { depth, bevelEnabled: true, bevelThickness: 3, bevelSize: 1.6, bevelSegments: 3, curveSegments: 18 });
        const mesh = new THREE.Mesh(geometry, material);
        mesh.position.z = i * 2.2;
        bull.add(mesh);
      }
    });
    // SVG y grows downward: flip it, then center the bull on its bounding box.
    bull.scale.set(2.2, -2.2, 2.2);
    const box = new THREE.Box3().setFromObject(bull);
    const center = box.getCenter(new THREE.Vector3());
    bull.position.sub(center);
    const pivot = new THREE.Group();
    pivot.add(bull);
    scene.add(pivot);

    const resize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(canvas);
    resize();

    const target = { x: 0, y: 0 };
    addEventListener("pointermove", (e) => {
      target.y = (e.clientX / innerWidth - 0.5) * 0.9;
      target.x = (e.clientY / innerHeight - 0.5) * 0.5;
    });

    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(canvas);
    const clock = new THREE.Clock();
    renderer.setAnimationLoop(() => {
      if (!visible) return;
      const t = clock.getElapsedTime();
      // Ease toward the pointer, plus a slow idle sway so the bull never looks frozen.
      pivot.rotation.y += (target.y + Math.sin(t * 0.6) * 0.18 - pivot.rotation.y) * 0.06;
      pivot.rotation.x += (target.x + Math.sin(t * 0.8) * 0.04 - pivot.rotation.x) * 0.06;
      renderer.render(scene, camera);
    });
    root.dataset.ready = "";
  }
</script>
